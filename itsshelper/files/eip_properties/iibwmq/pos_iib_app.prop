# Relies on some exported environment variables:
# ENV
QMGR_TEMPLATE=${CONFIGDIR}/pos_iib_app.template
QMTYPE=Apps
CLUSTER=${ENV^^} # upper case
env=${ENV,,} # lower case
if [ -z "$HOST" ] ; then
        HOST=$(hostname)
fi
NUM=$(echo $HOST | grep -o '[0-9]*$')
QMGRNAME=$(echo A${ENV}I${NUM} | tr "[:lower:]" "[:upper:]")
QMHOST=$HOST

#
# Set the userids which will be assigned onto non-admin
# client channels
EXHIBITION="02"
HANSEN="01"
CLUSUSER=_mq_clus
IIBUSER=aceadmin

#CLWLPRTY set to route traffic to both systems equally by default
if [ "${NUM:0:2}" == "$HANSEN" ]; then
        QPRIORITY=0
else
        QPRIORITY=0
fi

# Set TAC MF QMGR for each environment
TAC_MF_QMGR=""
case "${env}" in
	"ci1" | "dv1" | "sv1" | "pa1" | "tr1") 
		TAC_MF_QMGR=MQA2 
		;;
	"ps1") 
		TAC_MF_QMGR=MQAQ
		;;
	"ts1") 
		TAC_MF_QMGR=MQA7 
		;;
	"ts2") 
		TAC_MF_QMGR=MQA3 
		;;
	"ts3") 
		TAC_MF_QMGR=MQAD
		;;
	"pr1") 
		TAC_MF_QMGR=MQCP 
		;;
	*) 
		TAC_MF_QMGR="dummy" 
		;;
esac
