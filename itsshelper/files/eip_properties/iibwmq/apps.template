* runmqsc command file template
* apps.template
* relies on apps.template.map

* ---------------------------------------------------
* Set defaults for channels
alter chl(SYSTEM.AUTO.RECEIVER) chltype(RCVR) -
        npmspeed(normal) -
	mcauser('mqnoaccess')
alter chl(SYSTEM.AUTO.SVRCONN) chltype(SVRCONN) -
	mcauser('mqnoaccess')
alter chl(SYSTEM.DEF.CLUSRCVR) chltype(CLUSRCVR) -
	npmspeed(normal) -
	mcauser('mqnoaccess')
alter chl(SYSTEM.DEF.CLUSSDR) chltype(CLUSSDR) -
        npmspeed(normal)
alter chl(SYSTEM.DEF.RECEIVER) chltype(RCVR) -
        npmspeed(normal) -
	mcauser('mqnoaccess')
alter chl(SYSTEM.DEF.REQUESTER) chltype(RQSTR) -
        npmspeed(normal) -
	mcauser('mqnoaccess')
alter chl(SYSTEM.DEF.SENDER) chltype(SDR) -
        npmspeed(normal)
alter chl(SYSTEM.DEF.SERVER) chltype(SVR) -
        npmspeed(normal)
alter chl(SYSTEM.DEF.SVRCONN) chltype(SVRCONN) -
	mcauser('mqnoaccess')

* ---------------------------------------------------
* Set defaults for queues
alter qlocal(SYSTEM.DEFAULT.LOCAL.QUEUE) -
        npmclass(high) -
	defbind(notfixed)

alter qremote(SYSTEM.DEFAULT.REMOTE.QUEUE) -
	defbind(notfixed)

alter qalias(SYSTEM.DEFAULT.ALIAS.QUEUE) -
	defbind(notfixed)

alter qmodel(SYSTEM.DEFAULT.MODEL.QUEUE) -
        npmclass(high)

* ---------------------------------------------------
* Disable Reverse DNS lookup for performance and security
alter qmgr revdns(disabled)

* ---------------------------------------------------
* Use separate transmit queue for each cluster channel
alter qmgr defclxq(channel)

* ---------------------------------------------------
* Enable monitoring of queue and channel timings
alter qmgr monq(high) monchl(high)


* ---------------------------------------------------
* Set up queue manager to keep cluster messages local
* ---------------------------------------------------

alter qmgr clwluseq(local)

* ---------------------------------------------------
* Tell qmgr to restrict SSL/TLS to using FIPS certified ciphers
alter qmgr sslfips(yes)

* ---------------------------------------------------
* Tell MQ how to do OS based authentication
define authinfo(CLIENT.IDPWOS) authtype(idpwos) -
	descr('Force client admins to sign in. Local is allowed') -
	adoptctx(yes) -
	chckclnt(optional) -
	chcklocl(optional) -
	replace

* ---------------------------------------------------
* Tell MQ how to do LDAP based authentication and authorization
define authinfo(CLIENT.IDPWLDAP) authtype(idpwldap) -
	descr('Force client admins to sign in. Everything is LDAP') -
	adoptctx(yes) -
	chckclnt(optional) -
	chcklocl(optional) -
	authormd(__AUTHORMD__) -
	basedng('__BASEDNG__') -
	basednu('__BASEDNU__') -
	classgrp('__CLASSGRP__') -
	classusr('__CLASSUSR__') -
	conname('__CONNAME__(__LDAPPORT__)') -
	findgrp('__FINDGRP__') -
	grpfield('__GRPFIELD__') -
	ldapuser('__LDAPUSER__') -
	ldappwd('__LDAPPWD__') -
	nestgrp(__NESTGRP__) -
	seccomm(__SECCOMM__) -
	shortusr('__SHORTUSR__') -
	usrfield('__USRFIELD__') -
	replace

* ---------------------------------------------------
* Tell QMGR to use LDAP based authentication
* and authorization
alter qmgr connauth(CLIENT.IDPWLDAP)

* ---------------------------------------------------
* Activate LDAP authentication and authorization
refresh security(*) type(connauth)

* ---------------------------------------------------
* Define listener on TCP port PORT
define listener(TCP.LISTENER) -
	trptype(tcp) -
	descr('TCP Listener for QMGR __QMGRNAME__') -
	control(qmgr) -
	port(__QMPORT__) -
	backlog(20) -
	ipaddr('__QMGRHOST__') -
	replace

* ---------------------------------------------------
* Start the listener so that cluster creation can work
start listener(TCP.LISTENER)

* ---------------------------------------------------
* Create client channel for QM administration
define chl(ADMIN.__QMGRNAME__) -
	chltype(svrconn) -
	descr('Administer QM via this admin channel') -
	trptype(tcp) -
	mcauser('mqnoaccess') -
	maxinst(20) -
	replace

* ---------------------------------------------------
* Create client channel for QM monitoring
define chl(MONITOR.__QMGRNAME__) -
	chltype(svrconn) -
	descr('Monitor QM via this admin channel') -
	trptype(tcp) -
	mcauser('__MONITORUSER__') -
	maxinst(20) -
	replace

* ---------------------------------------------------
* Set up user mapping for channels.
* Cluster channels map by queue manager name (here)
* Admin Client channels map by login (via authinfo)

* Map cluster receiver channel users from the incoming
* generic queue manager name

* Full Repo qmgr -> __MQREPOUSER__
set chlauth('__CLUSNAME__.__QMGRNAME__') -
	type(qmgrmap) -
	descr('Map generic repo QMGR NAME to a user') -
	qmname('__REPOPREFIX__*') -
	usersrc(map) -
	mcauser('__MQREPOUSER__') -
	action(add)

* App Qmgr -> __MQCLUSUSER__
set chlauth('__CLUSNAME__.__QMGRNAME__') -
	type(qmgrmap) -
	descr('Map generic app QMGR NAME to a user') -
	qmname('__SHORTPREFIX__*') -
	usersrc(map) -
	mcauser('__MQCLUSUSER__') -
	action(add)

* ADMIN Client -> Authenticated user
set chlauth('ADMIN.__QMGRNAME__') -
	type(addressmap) -
	chckclnt(required) -
	address('*') -
	usersrc(map) -
	mcauser('MQADMIN')

* ADMIN Client -> Allow admin users
set chlauth('ADMIN.__QMGRNAME__') -
        type(blockuser) -
        userlist('mqnoaccess')

