* ---------------------------------------------------
* Create cluster receiver channel
* This has to be done after security controls are set
* in order to avoid errors
define chl(__CLUSNAME__.__QMGRNAME__) -
	chltype(clusrcvr) -
	trptype(tcp) -
	descr('App Queue Manager in cluster __CLUSNAME__') -
	conname('__QMGRHOST__(__QMPORT__)') -
	mcauser('mqnoaccess') -
	cluster('__CLUSNAME__') -
	npmspeed(normal) -
	replace

* ---------------------------------------------------
* Create cluster sender channel to FR
define chl(__CLUSNAME__.__REPOQM__) -
	chltype(clussdr) -
	trptype(tcp) -
	descr('Connect to repos for cluster CLUSNAME') -
	conname('__REPOHOST__(__REPOPORT__)') -
	cluster('__CLUSNAME__') -
	npmspeed(normal) -
	replace

* ---------------------------------------------------
* Define TOPIC root for MQ events
define topic(MQ.EVENTS) -
	topicstr('/system/admin/events') -
	npmsgdlv(allavail) -
	pmsgdlv(alldur) -
	pubscope(qmgr) -
	subscope(qmgr) -
	usedlq(no) -
	replace

* ---------------------------------------------------
* Define all TOPICs for MQ events
define topic(MQ.CHANNEL.EVENTS) topicstr('/system/admin/events/channel') replace
define topic(MQ.COMMAND.EVENTS) topicstr('/system/admin/events/command') replace
define topic(MQ.CONFIG.EVENTS) topicstr('/system/admin/events/config') replace
define topic(MQ.LOGGER.EVENTS) topicstr('/system/admin/events/logger') replace
define topic(MQ.PERFM.EVENTS) topicstr('/system/admin/events/perfm') replace
define topic(MQ.PUBSUB.EVENTS) topicstr('/system/admin/events/pubsub') replace
define topic(MQ.QMGR.EVENTS) topicstr('/system/admin/events/qmgr') replace

* ---------------------------------------------------
* Set up qmgr to publish all events
alter qmgr -
	authorev(enabled) -
	chlev(enabled) -
	cmdev(enabled) -
	configev(enabled) -
	inhibtev(enabled) -
	localev(enabled) -
	perfmev(enabled) -
	remoteev(enabled) -
	sslev(enabled) -
	strstpev(enabled)

* ---------------------------------------------------
* Set up qmgr trigger interval to 60 seconds
alter qmgr -
        trigint(60000)

* ---------------------------------------------------
* Refresh security to activate the new rules
refresh security(*) type(authserv)

