* ---------------------------------------------------
* Define Queues - ES_LMS
* ---------------------------------------------------

define ql('ES.AURION.BOQ.V2') -
 descr('Backout queue for ES_LMS') -
 replace

define ql('ES.AURION.REQ.V2') -
 descr('Request queue for ES_LMS') -
 cluster(__CLUSNAME__) -
 clwlprty(__QPRIORITY__) -
 boqname('ES.AURION.BOQ.V2') -
 bothresh(1) -
 replace

define ql('ES.AURION.RESP.V2') -
 descr('Response queue for ES_LMS') -
 replace


