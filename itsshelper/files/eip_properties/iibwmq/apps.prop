#
# /opt/properties/apps.prop
#
# -   Define properties for Default IIB queue manager
#
# -   Depends on the exported environment variable:
#
#         ENV
#
# -   Depends on the variables in `common_vars.bash`:
#
#         HOST
#         NUM
#         CONFIGDIR
#
# -   Depends on the properties files:
#
#         mqrepo.properties
#         mqenvironments.properties
#         mqldap.properties
#
# -   Derived from properties file in `itsshelper` repository
#

#
#
# Obtain case-specific versions of ENV
LENV=${ENV,,}            # lower case
UENV=${ENV^^}            # upper case
#
#
# Specify the template
TEMPLATE=${CONFIGDIR}/apps.template
#
#
# Derive the indices for environment and type
source ${CONFIGDIR}/mqenvironments.properties
E=${MQRevEnvMap[$UENV]}
T=I
#
#
# Compute the queue manager name and host elements
QMGRNAME=$(echo A${ENV}${T}${NUM} | tr "[:lower:]" "[:upper:]")
QMPREFIX=$(echo ${ENV}${E}${T} | tr "[:lower:]" "[:upper:]")
SHORTPREFIX=$(echo ${ENV}${E}$ | tr "[:lower:]" "[:upper:]")
QMHOST=$(echo ${HOST}-${ENV} | tr "[:upper:]" "[:lower:]")
#
#
#
# Derive the full repository details
source ${CONFIGDIR}/mqrepo.properties
REPOQM=${MQREPOSLIST[${QMGRNAME}]}
REPOENV=$(echo $REPOQM | cut -c 4)
REPONUM=$(echo $REPOQM | cut -c 6-)
REPOPREFIX=$(echo $REPOQM | cut -c 1-5)
REPOHOST=$(echo s${REPOENV}uwmq${REPONUM}-${ENV} | tr "[:upper:]" "[:lower:]")
QMTYPE=Apps
QMPORT=1414
REPOPORT=1415
CLUSTER=${UENV}
PROCSTRING="/opt/ibm/${LENV}/mqm/bin/amq"
#
#
# Fix up roles once they are created in LDAP
# MONITORROLE=mqmonitor
# ADMINROLE="ROL-PAM-MQ-ADMIN-"${E}
# ADMINROLE=mqadmin
# ADMINROLE=ROL-PAM-APPLICATION-SERVICES
# MONITORROLE=CARLB1
# DEVROLE=PULLV1
# READERROLE=CASEN1
#
#
# Configure the Long, Upper Case environment name (LUENV)
# Import the mapping file, then declare the variable
LUENV=${MQEnvMap[$E]}
#
#
MONITORUSER=_mq_monitor
CLUSUSER=_mq_clus
REPOUSER=_mq_repos
ADMINROLE=ROL-MQ-${LUENV}-ADMIN
READERROLE=ROL-MQ-${LUENV}-MONITOR
DEVROLE=ROL-MQ-${LUENV}-APPADMIN
#
#
# Configure LDAP. Look up Bind User and Password based on the 
# Environment letter in the host name (<E>)
#
# Include declations and data for LDAPBindUsr, LDAPBindPW and LDAPConn
source ${CONFIGDIR}/mqldap.properties
MQAUTHORMD="SEARCHUSR"
MQBASEDNG="o=vwa"
MQBASEDNU=$MQBASEDNG
MQCLASSGRP="groupOfNames"
MQCLASSUSR="inetOrgPerson"
MQLDAPCONN=$(echo ${LDAPConn[$E]} | awk -F "//" "{print \$2}")
MQLDAPPROT=$(echo ${LDAPConn[$E]} | awk -F "//" "{print \$1}")
if [ "$MQLDAPPROT" == "ldap:" ]
then
    MQLDAPPORT=389
    MQLDAPSEC=NO
else
    MQLDAPPORT=636
    MQLDAPSEC=ANON
fi
MQFINDGRP="groupMembership"
MQGRPFIELD="cn"
MQLDAPPWD="${LDAPBindPW[$E]}"
MQLDAPUSER="${LDAPBindUsr[$E]}"
MQNESTGRP="NO"
MQSHORTUSR=shortName
MQUSRFIELD="$MQSHORTUSR"
