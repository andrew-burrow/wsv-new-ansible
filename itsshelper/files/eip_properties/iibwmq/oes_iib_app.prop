# Relies on some exported environment variables:
# ENV
QMGR_TEMPLATE=${CONFIGDIR}/oes_iib_app.template
QMTYPE=Apps
CLUSTER=${ENV^^} # upper case
env=${ENV,,} # lower case
if [ -z "$HOST" ] ; then
        HOST=$(hostname)
fi
NUM=$(echo $HOST | grep -o '[0-9]*$')
QMGRNAME=$(echo A${ENV}I${NUM} | tr "[:lower:]" "[:upper:]")
QMHOST=$HOST

#
# Set the userids which will be assigned onto non-admin
# client channels
EXHIBITION="02"
HANSEN="01"
CLUSUSER=_mq_clus
IIBUSER=iibadmin

#CLWLPRTY set to route traffic to both systems equally by default
if [ "${NUM:0:2}" == "$HANSEN" ]; then
        QPRIORITY=0
else
        QPRIORITY=0
fi

# Set VWA MF QMGR for each environment
VWA_MF_QMGR=""
case "${env}" in
	"ci1") 
		VWA_MF_QMGR=V208
		;;
	"dv1") 
		VWA_MF_QMGR=V209
		;;
	"ts1") 
		VWA_MF_QMGR=V128 
		;;
	"ts2") 
		VWA_MF_QMGR=V129 
		;;
	"sv1") 
		VWA_MF_QMGR=V211 
		;;
	"tr1") 
		VWA_MF_QMGR=V213 
		;;
	"pr1") 
		VWA_MF_QMGR=V210 
		;;
	"ps1" | "ts3" | "pa1") 
		VWA_MF_QMGR=MQA2 
		;;
	*) 
		VWA_MF_QMGR="dummy" 
		;;
esac
