#
# -   Define properties for MQ app
#
# -   Depends on the shell variables:
#
#         ENV
#         HOST
#         NUM
#         CONFIGDIR
#
# -   Depends on the properties files:
#
#         mqrepo.properties
#         mqenvironments.properties
#
# -   Derived from properties file in `itsshelper` repository
#

#
#
# Obtain case-specific versions of ENV
LENV=${ENV,,}            # lower case
UENV=${ENV^^}            # upper case
#
#
# Specify the template, type, and cluster
TEMPLATE=${CONFIGDIR}/oes_iib_app.template
QMTYPE=Apps
CLUSTER=${UENV}
#
#
# Derive the indices for environment and type
source ${CONFIGDIR}/mqenvironments.properties
E=${MQRevEnvMap[$UENV]}
T=I
#
#
# Compute the queue manager name and host elements
QMGRNAME=$(echo A${ENV}${T}${NUM} | tr "[:lower:]" "[:upper:]")
QMHOST=$HOST
#
#
# Set the userids which will be assigned onto non-admin
# client channels
EXHIBITION="02"
HANSEN="01"
CLUSUSER=_mq_clus
IIBUSER=aceadmin
#
#
# CLWLPRTY set to route traffic to both systems equally by default
if [ "${NUM:0:2}" == "$HANSEN" ]; then
        QPRIORITY=0
else
        QPRIORITY=0
fi
#
#
# Set VWA MF QMGR for each environment
VWA_MF_QMGR=""
case "${LENV}" in
        "ci1")
                VWA_MF_QMGR=V208
                ;;
        "dv1")
                VWA_MF_QMGR=V209
                ;;
        "ts1")
                VWA_MF_QMGR=V128
                ;;
        "ts2")
                VWA_MF_QMGR=V129
                ;;
        "sv1")
                VWA_MF_QMGR=V211
                ;;
        "tr1")
                VWA_MF_QMGR=V213
                ;;
        "pr1")
                VWA_MF_QMGR=V210
                ;;
        "ps1" | "ts3" | "pa1")
                VWA_MF_QMGR=MQA2
                ;;
        *)
                VWA_MF_QMGR="dummy"
                ;;
esac
