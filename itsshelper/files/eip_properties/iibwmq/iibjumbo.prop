# Define properties for the IIB application
#
QMGR_TEMPLATE=${CONFIGDIR}/iib.template
IIBUSER=iibadmin
HOST=$(hostname)
NUM=$(echo $HOST | grep -o '[0-9]*$')
QMGRNAME=$(echo A${ENV}J${NUM} | tr "[:lower:]" "[:upper:]")
CLUSTER=${ENV,,} # lower case
EXHIBITION="02"
HANSEN="01"
CLUSUSER=_mq_clus
#CLWLPRTY set to route traffic to HANSEN queues by default
if [ "${NUM:0:2}" == "$HANSEN" ]; then
        QPRIORITY=5
else
        QPRIORITY=0
fi

