#
# -   Define properties for MQ app
#
# -   Depends on the shell variables:
#
#         ENV
#         HOST
#         NUM
#         CONFIGDIR
#
# -   Depends on the properties files:
#
#         mqenvironments.properties
#
# -   Derived from properties file in `itsshelper` repository
#

#
#
# Obtain case-specific versions of ENV
LENV=${ENV,,}            # lower case
UENV=${ENV^^}            # upper case
#
#
# Specify the template, type, and cluster
TEMPLATE=${CONFIGDIR}/lnr_iib_app.template
QMTYPE=Jumbo
CLUSTER=${UENV}
#
#
# Derive the indices for environment and type
source ${CONFIGDIR}/mqenvironments.properties
E=${MQRevEnvMap[$UENV]}
T=J
#
#
# Compute the queue manager name and host elements
QMGRNAME=$(echo A${ENV}${T}${NUM} | tr "[:lower:]" "[:upper:]")
QMHOST=$HOST
#
#
# Set the userids which will be assigned onto non-admin
# client channels
CLUSUSER=_mq_clus
IIBUSER=aceadmin
#
#
# Define site specific host values
EXHIBITION="02"
HANSEN="01"
HOSTSITE=${NUM:0:2}
if [ "$HOSTSITE" = "$HANSEN" ] ; then
	QLOCATION="HANSEN"
else
	QLOCATION="EXHIBITION"
fi
