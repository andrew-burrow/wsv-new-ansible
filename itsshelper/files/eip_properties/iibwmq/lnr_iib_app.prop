# Relies on some exported environment variables:
# ENV
QMGR_TEMPLATE=${CONFIGDIR}/lnr_iib_app.template
QMTYPE=Jumbo
CLUSTER=${ENV^^} # upper case
env=${ENV,,} # lower case
if [ -z "$HOST" ] ; then
        HOST=$(hostname)
fi
NUM=$(echo $HOST | grep -o '[0-9]*$')
QMGRNAME=$(echo A${ENV}J${NUM} | tr "[:lower:]" "[:upper:]")
QMHOST=$HOST

#
# Set the userids which will be assigned onto non-admin
# client channels
CLUSUSER=_mq_clus
IIBUSER=aceadmin

#
# Define site specific host values
EXHIBITION="02"
HANSEN="01"

HOSTSITE=${NUM:0:2}
if [ "$HOSTSITE" = "$HANSEN" ] ; then
	QLOCATION="HANSEN"
else
	QLOCATION="EXHIBITION"
fi
