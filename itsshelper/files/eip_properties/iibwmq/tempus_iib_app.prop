#
# -   Define properties for MQ app
#
# -   Depends on the exported environment variable:
#
#         ENV
#
# -   Depends on the variables in `common_vars.bash`:
#
#         HOST
#         NUM
#         CONFIGDIR
#
# -   Depends on the properties files:
#
#         mqenvironments.properties
#         mqgateway.properties
#
# -   Derived from properties file in `itsshelper` repository
#

#
#
# Obtain case-specific versions of ENV
LENV=${ENV,,}            # lower case
UENV=${ENV^^}            # upper case
#
#
# Specify the template, type, and cluster
TEMPLATE=${CONFIGDIR}/tempus_iib_app.template
QMTYPE=Apps
CLUSTER=${UENV}
#
#
# Derive the indices for environment and type
source ${CONFIGDIR}/mqenvironments.properties
E=${MQRevEnvMap[$UENV]}
T=I
#
#
# Compute the queue manager name and host elements
QMGRNAME=$(echo A${ENV}${T}${NUM} | tr "[:lower:]" "[:upper:]")
QMHOST=$HOST
#
#
source ${CONFIGDIR}/mqgateway.properties
AWSQM=${MQIIBLIST[${QMGRNAME}]}
#
#
# MuleSoft MQ
GWYQMGR=$(echo ${ENV}${E}G${NUM} | tr "[:lower:]" "[:upper:]")
MULEQM=${MQMULELIST[${GWYQMGR}]}
if [[ "$env" == "ts1"  ||  "$env" == "pr1" ]] ; then
        MULEQMB=${MQMULELIST[${GWYQMGR}B]}
else
        MULEQMB=${MQMULELIST[${GWYQMGR}]}
fi
#
#
# Set the userids which will be assigned onto non-admin
# client channels
EXHIBITION="02"
HANSEN="01"
CLUSUSER=_mq_clus
IIBUSER=aceadmin
#
#
# CLWLPRTY set to route traffic to both systems equally by default
if [ "${NUM:0:2}" == "$HANSEN" ]; then
        QPRIORITY=0
else
        QPRIORITY=0
fi
#
#
# Set TAC MF QMGR for each environment
TAC_MF_QMGR=""
case "${LENV}" in
        "ci1" | "dv1" | "sv1" | "pa1" | "tr1")
                TAC_MF_QMGR=MQA2
                ;;
        "ps1")
                TAC_MF_QMGR=MQAQ
                ;;
        "ts1")
                TAC_MF_QMGR=MQA7
                ;;
        "ts2")
                TAC_MF_QMGR=MQA3
                ;;
        "ts3")
                TAC_MF_QMGR=MQAD
                ;;
        "pr1")
                TAC_MF_QMGR=MQCP
                ;;
        *)
                TAC_MF_QMGR="dummy"
                ;;
esac
