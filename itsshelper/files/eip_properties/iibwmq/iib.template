* runmqsc command file template
* iib.template
* relies on iib.template.map

* ---------------------------------------------------
* Set up security controls for access to IIB

* Allow admin access by service account IIBUSER
* Access to qmgr
set authrec -
	objtype(qmgr) -
	principal('__IIBUSER__') -
	authrmv(all) -
	authadd(chg, -
		connect, -
		crt, -
		dlt, -
		dsp, -
		inq, -
		set, -
		setall, -
		setid, -
		system)

* Access to all authinfo objects
set authrec -
	objtype(authinfo) -
	profile('**') -
	principal('__IIBUSER__') -
	authrmv(all) -
	authadd(alladm)

* Access to all channel objects
set authrec -
	objtype(channel) -
	profile('**') -
	principal('__IIBUSER__') -
	authrmv(all) -
	authadd(alladm)

* Access to all clntconn objects
set authrec -
	objtype(clntconn) -
	profile('**') -
	principal('__IIBUSER__') -
	authrmv(all) -
	authadd(alladm)

* Access to all comminfo objects
set authrec -
	objtype(comminfo) -
	profile('**') -
	principal('__IIBUSER__') -
	authrmv(all) -
	authadd(alladm)

* Access to all listener objects
set authrec -
	objtype(listener) -
	profile('**') -
	principal('__IIBUSER__') -
	authrmv(all) -
	authadd(alladm)

* Access to all namelist objects
set authrec -
	objtype(namelist) -
	profile('**') -
	principal('__IIBUSER__') -
	authrmv(all) -
	authadd(alladm)

* Access to all process objects
set authrec -
	objtype(process) -
	profile('**') -
	principal('__IIBUSER__') -
	authrmv(all) -
	authadd(alladm)

* Access to all queue objects
set authrec -
	objtype(queue) -
	profile('**') -
	principal('__IIBUSER__') -
	authrmv(all) -
	authadd(alladm, -
		allmqi)

* Access to all rqmname objects
set authrec -
	objtype(rqmname) -
	profile('**') -
	principal('__IIBUSER__') -
	authrmv(all) -
	authadd(alladm)

* Access to all service objects
set authrec -
	objtype(service) -
	profile('**') -
	principal('__IIBUSER__') -
	authrmv(all) -
	authadd(alladm)

* Access to all topic objects
set authrec -
	objtype(topic) -
	profile('**') -
	principal('__IIBUSER__') -
	authrmv(all) -
	authadd(alladm, -
		allmqi)

* ---------------------------------------------------
* Refresh security to activate the new rules
refresh security(*) type(authserv)

* ---------------------------------------------------
* Create IIB objects for the broker.
* These statements are taken from 
*   /opt/<env>/iib/server/sample/wmq/iib_queues_create.mqsc

* Increase the maximum message size
ALTER QMGR MAXMSGL(104857600)


* ---------------------------------------------------
* Set up queue manager to keep cluster messages local
* ---------------------------------------------------

alter qmgr clwluseq(local)

* This step might fail on MQ 7.0.1
* Removed as it screws up MQ security
* ALTER QMGR CHLAUTH(DISABLED)

