#
# 
#
# program:	"import-signer.jy"
# date:		April 08 2015
# pupose:	Configure ldap federated repository
# usage: 	"import-signer.jy <props file> 
#		where <props file> is formatted like a windows .ini file with a [SECURITY] section and the following properties
#		root_signer_cert- full path to root signer certificate, e.g. /opt/IBM/SOE/ICAD/config/novus/POT/test-org-ca-edir.cer


import ConfigParser

def print_usage():
	print "USAGE: import-signer.jy 'property file'"


if len(sys.argv) != 1:
	print_usage
	sys.exit(-1)
	
props_file = sys.argv[0]

props = ConfigParser.ConfigParser()
props.read(props_file)
section = 'SECURITY'


def getProperty(prop_name):
	prop_value = ''
	if props.has_option(section, prop_name):
		prop_value = props.get(section, prop_name)
		print "PROPERTY: %s = %s" % (prop_name, prop_value)
		return prop_value
	else:
		print 'ERROR: missing property: %s' % prop_name
		sys.exit(1)

root_signer_cert = getProperty('root_signer_cert')

_excp_ = 0

print "INFO: adding root signer..."
certs = AdminTask.listSignerCertificates('[-keyStoreName CellDefaultTrustStore]').splitlines()
root_cert_exists = 0
for cert in certs:
	alias = cert[cert.find('alias')+6:cert.find(']')]
	if alias == 'enldap':
		print('INFO: Root signer cert already exists.')
		root_cert_exists = 1
if not (root_cert_exists):
	print 'INFO: Adding root signer cert.'
	args = '[-keyStoreName CellDefaultTrustStore -certificateAlias enldap -certificateFilePath %s -base64Encoded true]' % root_signer_cert
	AdminTask.addSignerCertificate(args)
	print "IMPORTANT INFO: saving... configuration incomplete... re-run after restart of dmgr..."
	AdminConfig.save()
	sys.exit(0)
	

