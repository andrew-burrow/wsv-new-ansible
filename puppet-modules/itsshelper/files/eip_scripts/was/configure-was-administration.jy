#
# 
#
# program:	"configure-was-administration.jy"
# date:		April 08 2015
# pupose:	Configure ldap WAS administration
# usage: 	"configure-was-administration.jy <props file> 
#		where <props file> is formatted like a windows .ini file with a [SECURITY] section and the following properties
#		repo		- a label for the repository, e.g. 'enldap'
#		admin_user 	- user name for the WAS admin user, e.g. cn=WASADMIN_Novus-TSTA,ou=admin,o=vwa
#		bind_user 	- ldap bind user
#		ldap_host	- FQDN of ldap host, e.g. devldbendlap.services.workcover.vic.gov.au
#		ldap_port	- secure port for ldap, e.g. 636
#		realm_name	- SSO domain's realm name, e.g. enldap.services.workcover.vic.gov.au
#		root_signer_cert- full path to root signer certificate, e.g. /opt/IBM/SOE/ICAD/config/novus/POT/test-org-ca-edir.cer


import ConfigParser
import re

def print_usage():
	print "USAGE: configure-was-administration.jy 'property file'"


if len(sys.argv) != 1:
	print_usage
	sys.exit(-1)
	
props_file = sys.argv[0]

props = ConfigParser.ConfigParser()
props.read(props_file)
section = 'SECURITY'


def getProperty(prop_name):
	prop_value = ''
	if props.has_option(section, prop_name):
		prop_value = props.get(section, prop_name)
		print "PROPERTY: %s = %s" % (prop_name, prop_value)
		return prop_value
	else:
		print 'ERROR: missing property: %s' % prop_name
		sys.exit(1)

repo = getProperty('repo')
admin_user = getProperty('admin_user')
bind_user = getProperty('bind_user')
bind_pass = getProperty('bind_pass')
ldap_host = getProperty('ldap_host')
ldap_port = getProperty('ldap_port')
realm_name = getProperty('realm_name')
root_signer_cert = getProperty('root_signer_cert')
op_user = getProperty('op_user')
op_group = getProperty('op_group')
monitor_group = getProperty('monitor_group')
admin_group = getProperty('admin_group')

_excp_ = 0

print "INFO: removing admin user/group assignments"
grouproles=AdminTask.listGroupIDsOfAuthorizationGroup()
for role in 'monitor', 'configurator', 'administrator', 'deployer', 'iscadmins', 'operator', 'adminsecuritymanager':
	p = re.compile('.*' + role + '=\[(.*?)\]')
	m = p.match(grouproles)
	for group in (admin_group, monitor_group, op_group):
		if m and m.group(1).find(group) >= 0:
			print 'deleting group %s from role %s' % (group,role)
 			AdminTask.removeGroupsFromAdminRole('[-groupids [%s] -roleName %s]' % (group,role))
userroles=AdminTask.listUserIDsOfAuthorizationGroup()
for role in 'monitor', 'configurator', 'administrator', 'deployer', 'iscadmins', 'operator', 'adminsecuritymanager':
	p = re.compile('.*' + role + '=\[(.*?)\]')
	m = p.match(userroles)
	user = op_user
	if m and m.group(1).find(user) >= 0:
		print 'deleting user %s from role %s' % (user,role)
		AdminTask.removeUsersFromAdminRole('[-userids [%s] -roleName %s]' % (user,role))


AdminConfig.save()
print "INFO: saving"

print "INFO: adding console users and groups... "
AdminConfig.reset()
AdminTask.mapGroupsToAdminRole('[-roleName administrator -groupids [ %s ] -accessids [ group:%s/cn=%s,ou=groups,o=vwa ] ]' % (admin_group,realm_name,admin_group) )
AdminTask.mapGroupsToAdminRole('[-roleName monitor -groupids [ %s ]  -accessids [ group:%s/cn=%s,ou=groups,o=vwa ]]' % (monitor_group,realm_name,monitor_group) )
AdminTask.mapGroupsToAdminRole('[-roleName operator -groupids [ %s ]  -accessids [ group:%s/cn=%s,ou=groups,o=vwa ]]' % (op_group,realm_name,op_group) )
AdminTask.mapUsersToAdminRole('[-userids [ %s ] -roleName operator]' % op_user)

# ensure AUTH aliases are not pre-pended with node name
AdminTask.setAdminActiveSecuritySettings('[-customProperties [ "com.ibm.websphere.security.JAASAuthData.removeNodeNameGlobal=true" ] ]')

print "INFO: saving..." 
AdminConfig.save()
#AdminNodeManagement.syncActiveNodes()
#AdminNodeManagement.restartActiveNodes()
print "CONFIGURATION COMPLETE: restart server for configuration to take effect..." 
sys.exit(0)
