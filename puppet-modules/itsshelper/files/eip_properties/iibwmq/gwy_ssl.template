* ---------------------------------------------------
* Change cluster sender channel to FR to be SSL enabled
alter chl(__CLUSTER__.__REPOQM__) -
	chltype(clussdr) -
	trptype(tcp) -
	sslciph(TLS_RSA_WITH_AES_128_CBC_SHA256) -
	sslpeer('CN=*, OU=*/__CLUSTER__/*, OU=IBM MQ QMgr, O=ITSS, L=Melbourne, S=VIC, C=AU')

* ---------------------------------------------------
* Change receiver channel from AWS to enforce SSL
alter chl(__AWSQM__.__QMGRNAME__) -
	chltype(rcvr) -
	trptype(tcp) -
	sslciph(TLS_RSA_WITH_AES_256_CBC_SHA256) -
	sslpeer('CN=__AWSQM__, OU=*, OU=*, O=ITSS, L=*, S=VIC, C=AU') -
	sslcauth(required)

* ---------------------------------------------------
*  App qmgr -> __MQAWSUSER__
set chlauth('__AWSQM__.__QMGRNAME__') -
        type(sslpeermap) -
        descr('Map AWS QMGR NAME from CN to a user') -
        sslpeer('CN=__AWSQM__, OU=IBM MQ QMgr, OU=*/__CLUSTER__/*, O=ITSS, L=Geelong, S=VIC, C=AU') -
        sslcerti('CN=WINVMCA1, DC=melb, DC=ad') -
        usersrc(map) -
        mcauser('__MQAWSUSER__') -
        action(replace)

*  App qmgr -> __MQAWSUSER__ (with reversed OU fields and L=Melbourne)
set chlauth('__AWSQM__.__QMGRNAME__') -
        type(sslpeermap) -
        descr('Map AWS QMGR NAME from CN to a user') -
        sslpeer('CN=__AWSQM__, OU=*/__CLUSTER__/*, OU=IBM MQ QMgr, O=ITSS, L=Melbourne, S=VIC, C=AU') -
        sslcerti('CN=WINVMCA1, DC=melb, DC=ad') -
        usersrc(map) -
        mcauser('__MQAWSUSER__') -
        action(replace)

* ---------------------------------------------------
*  Unknown certs -> noaccess
set chlauth('__AWSQM__.__QMGRNAME__') -
        type(sslpeermap) -
        descr('Map any other cert to NOACCESS') -
        sslpeer(' ') -
        sslcerti(' ') -
        usersrc(NOACCESS) -
        action(replace)

* ---------------------------------------------------
* Change sender channel to AWS to enforce SSL
alter chl(__QMGRNAME__.__AWSQM__) -
	chltype(sdr) -
	trptype(tcp) -
	sslciph(TLS_RSA_WITH_AES_256_CBC_SHA256) -
	sslpeer('CN=__AWSQM__, OU=*, OU=*, O=ITSS, L=*, S=VIC, C=AU')

* ---------------------------------------------------
*  App qmgr -> Allowed
set chlauth('__QMGRNAME__.__AWSQM__') -
        type(sslpeermap) -
        descr('Map AWS QMGR NAME from CN allowed') -
        sslpeer('CN=__AWSQM__, OU=IBM MQ QMgr, OU=*/__CLUSTER__/*, O=ITSS, L=Geelong, S=VIC, C=AU') -
        sslcerti('CN=WINVMCA1, DC=melb, DC=ad') -
        usersrc(channel) -
        action(replace)

*  App qmgr -> Allowed (with reversed OU fields and L=Melbourne)
set chlauth('__QMGRNAME__.__AWSQM__') -
        type(sslpeermap) -
        descr('Map AWS QMGR NAME from CN allowed') -
        sslpeer('CN=__AWSQM__, OU=*/__CLUSTER__/*, OU=IBM MQ QMgr, O=ITSS, L=Melbourne, S=VIC, C=AU') -
        sslcerti('CN=WINVMCA1, DC=melb, DC=ad') -
        usersrc(channel) -
        action(replace)

* ---------------------------------------------------
*  Unknown certs -> noaccess
set chlauth('__QMGRNAME__.__AWSQM__') -
        type(sslpeermap) -
        descr('Map any other cert to NOACCESS') -
        sslpeer(' ') -
        sslcerti(' ') -
        usersrc(NOACCESS) -
        action(replace)

* ---------------------------------------------------
* Refresh security to activate the new rules
refresh security(*) type(ssl)
refresh security(*) type(connauth)
refresh security(*) type(authserv)
