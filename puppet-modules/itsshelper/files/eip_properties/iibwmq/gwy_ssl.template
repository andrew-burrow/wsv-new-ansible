* runmqsc command file template
* gwy_ssl.template
* relies on gwy_ssl.template.map

* ---------------------------------------------------
* Make client channel for QM administration use SSL
alter chl(ADMIN.__QMGRNAME__) -
	chltype(svrconn) -
	trptype(tcp) -
	sslciph(TLS_RSA_WITH_AES_128_CBC_SHA256) -
	sslcauth(optional)

* ---------------------------------------------------
* Make client channel for QM monitoring require SSL
alter chl(MONITOR.__QMGRNAME__) -
	chltype(svrconn) -
	trptype(tcp) -
	sslciph(TLS_RSA_WITH_AES_128_CBC_SHA256) -
	sslcauth(optional)

* ---------------------------------------------------
* Change cluster receiver channel to enforce SSL
alter chl(__CLUSTER__.__QMGRNAME__) -
	chltype(clusrcvr) -
	trptype(tcp) -
	sslciph(TLS_RSA_WITH_AES_128_CBC_SHA256) -
	sslpeer('CN=*, OU=*/__CLUSTER__/*, OU=IBM MQ QMgr, O=ITSS, L=Melbourne, S=VIC, C=AU') -
	sslcauth(required)

* ---------------------------------------------------
* Change cluster channel security rules to use SSL instead of 
* QMGR Name for the mapping rule

* Full Repo qmgr -> __MQREPOUSER__
set chlauth('__CLUSTER__.__QMGRNAME__') -
        type(sslpeermap) -
        descr('Map generic repo QMGR NAME from CN to a user') -
        sslpeer('CN=__REPOPREFIX__*,OU=*/__CLUSTER__/*,OU=IBM MQ QMgr, O=ITSS, L=Melbourne, S=VIC, C=AU') -
        usersrc(map) -
        mcauser('__MQREPOUSER__') -
        action(replace)

*  App cluster qmgr -> __MQAPPUSER__
set chlauth('__CLUSTER__.__QMGRNAME__') -
        type(sslpeermap) -
        descr('Map generic app QMGR NAME from CN to a user') -
        sslpeer('CN=__SHORTPREFIX__M*,OU=*/__CLUSTER__/*,OU=IBM MQ QMgr, O=ITSS, L=Melbourne, S=VIC, C=AU') -
        usersrc(map) -
        mcauser('__MQAPPUSER__') -
        action(replace)

