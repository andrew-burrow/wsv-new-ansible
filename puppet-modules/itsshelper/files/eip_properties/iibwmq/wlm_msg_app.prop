WLM_LIST=(CS_Messaging FS_Messaging SC_Messaging TelstraMessaging)
 
declare -A WLM_POLICY_NAME ADDITIONAL_INSTANCES
 
for WLM in ${WLM_LIST[*]} ; do
  WLM_POLICY_NAME[${WLM}]=WLM_${WLM}
done
 
case "${env}" in
  "sv1" | "pr1")
    ADDITIONAL_INSTANCES[CS_Messaging]=2
    ADDITIONAL_INSTANCES[FS_Messaging]=8
    ADDITIONAL_INSTANCES[SC_Messaging]=10
    ADDITIONAL_INSTANCES[TelstraMessaging]=10
    ;;
  *)
    ADDITIONAL_INSTANCES[CS_Messaging]=2
    ADDITIONAL_INSTANCES[FS_Messaging]=2
    ADDITIONAL_INSTANCES[SC_Messaging]=2
    ADDITIONAL_INSTANCES[TelstraMessaging]=2
    ;;
esac