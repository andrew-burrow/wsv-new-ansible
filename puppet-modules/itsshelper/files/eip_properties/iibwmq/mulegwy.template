* Create MuleSoft Queue Manager Alias
define qr('__MQMULEQM__') -
    descr('Alias to allow reply messages to route to MuleSoft MQ') -
    rname(' ') -
    rqmname('__MQMULEQM__') -
    xmitq('XMITQ.__MQMULEQM__') -
    cluster('__CLUSNAME__') -
    clwlprty(__QPRTY__) -
    defbind(notfixed) -
    replace
    
