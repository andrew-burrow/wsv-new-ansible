WLM_LIST=(TransportAccidentClaimForm PCR AmbulanceVictoria SubmitClaimNotification GetClaimPCR AvantiDB EmailSender)
 
declare -A WLM_POLICY_NAME ADDITIONAL_INSTANCES
 
for WLM in ${WLM_LIST[*]} ; do
  WLM_POLICY_NAME[${WLM}]=WLM_${WLM}
done
 
case "${env}" in
  "sv1" | "pr1")
    ADDITIONAL_INSTANCES[TransportAccidentClaimForm]=3
    ADDITIONAL_INSTANCES[PCR]=2
    ADDITIONAL_INSTANCES[AmbulanceVictoria]=2
    ADDITIONAL_INSTANCES[SubmitClaimNotification]=2
    ADDITIONAL_INSTANCES[GetClaimPCR]=2
    ADDITIONAL_INSTANCES[AvantiDB]=2
	ADDITIONAL_INSTANCES[EmailSender]=2
    ;;
  *)
    ADDITIONAL_INSTANCES[TransportAccidentClaimForm]=2
    ADDITIONAL_INSTANCES[PCR]=2
    ADDITIONAL_INSTANCES[AmbulanceVictoria]=2
    ADDITIONAL_INSTANCES[SubmitClaimNotification]=2
    ADDITIONAL_INSTANCES[GetClaimPCR]=2
    ADDITIONAL_INSTANCES[AvantiDB]=2
	ADDITIONAL_INSTANCES[EmailSender]=2
    ;;
esac