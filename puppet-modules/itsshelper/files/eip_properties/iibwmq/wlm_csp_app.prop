WLM_LIST=(EDI Batch Repository StagingInvoice TransportAccidentInvoice AvantiInvoice StatusReport SAS_ClaimManagement TransportAccidentClaim Avanti ROL COL Cabs POS)

declare -A WLM_POLICY_NAME ADDITIONAL_INSTANCES

for WLM in ${WLM_LIST[*]} ; do
  WLM_POLICY_NAME[${WLM}]=WLM_${WLM}
done

case "${env}" in
  "sv1" | "pr1") 
    ADDITIONAL_INSTANCES[EDI]=2
    ADDITIONAL_INSTANCES[Batch]=2
    ADDITIONAL_INSTANCES[Repository]=2
    ADDITIONAL_INSTANCES[StagingInvoice]=2
    ADDITIONAL_INSTANCES[TransportAccidentInvoice]=2
    ADDITIONAL_INSTANCES[AvantiInvoice]=2
    ADDITIONAL_INSTANCES[StatusReport]=2
    ADDITIONAL_INSTANCES[SAS_ClaimManagement]=2
    ADDITIONAL_INSTANCES[TransportAccidentClaim]=2
    ADDITIONAL_INSTANCES[Avanti]=2
    ADDITIONAL_INSTANCES[ROL]=2
    ADDITIONAL_INSTANCES[COL]=2
    ADDITIONAL_INSTANCES[Cabs]=2
	ADDITIONAL_INSTANCES[POS]=2
    ;;
  *) 
    ADDITIONAL_INSTANCES[EDI]=2
    ADDITIONAL_INSTANCES[Batch]=2
    ADDITIONAL_INSTANCES[Repository]=2
    ADDITIONAL_INSTANCES[StagingInvoice]=2
    ADDITIONAL_INSTANCES[TransportAccidentInvoice]=2
    ADDITIONAL_INSTANCES[AvantiInvoice]=2
    ADDITIONAL_INSTANCES[StatusReport]=2
    ADDITIONAL_INSTANCES[SAS_ClaimManagement]=2
    ADDITIONAL_INSTANCES[TransportAccidentClaim]=2
    ADDITIONAL_INSTANCES[Avanti]=2
    ADDITIONAL_INSTANCES[ROL]=2
    ADDITIONAL_INSTANCES[COL]=2
    ADDITIONAL_INSTANCES[Cabs]=2
	ADDITIONAL_INSTANCES[POS]=2
    ;;
esac

