* Alter channels and define chlauth
* to permit SV1 AWS queue manager
* SV1VMA101 to connect using a certificate
* with CN=SV1TMA101.
 
alter chl(SV1VG0101.SV1VMA101) +
  chltype(sdr) +
  sslpeer('CN=*, OU=IBM MQ QMgr, OU=*/SV1/*, O=ITSS, L=Geelong, S=VIC, C=AU')
*
set chlauth(SV1VG0101.SV1VMA101) +
  type(sslpeermap) +
  descr('Map AWS QMGR NAME from CN allowed') +
  sslpeer('CN=SV1TMA101, OU=IBM MQ QMgr, OU=*/SV1/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
  sslcerti('CN=WINVMCA1, DC=melb, DC=ad') +
  usersrc(channel) +
  action(replace)
*
set chlauth(SV1VG0101.SV1VMA101) +
  type(sslpeermap) +
  descr('Map AWS QMGR NAME from CN allowed') +
  sslpeer('CN=SV1VMA101, OU=IBM MQ QMgr, OU=*/SV1/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
  sslcerti('CN=WINVMCA1, DC=melb, DC=ad') +
  usersrc(channel) +
  action(replace)
*
alter chl(SV1VMA101.SV1VG0101) +
  chltype(rcvr) +
  sslpeer('CN=*, OU=IBM MQ QMgr, OU=*, O=ITSS, L=Geelong, S=VIC, C=AU')
*
set chlauth(SV1VMA101.SV1VG0101) +
  type(sslpeermap) +
  descr('Map AWS QMGR NAME from CN allowed') +
  sslpeer('CN=SV1TMA101, OU=IBM MQ QMgr, OU=*/SV1/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
  sslcerti('CN=WINVMCA1, DC=melb, DC=ad') +
  usersrc(map) +
  MCAUSER('_mq_chl_aws') +
  action(replace)
*
set chlauth(SV1VMA101.SV1VG0101) +
  type(sslpeermap) +
  descr('Map AWS QMGR NAME from CN allowed') +
  sslpeer('CN=SV1VMA101, OU=IBM MQ QMgr, OU=*/SV1/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
  sslcerti('CN=WINVMCA1, DC=melb, DC=ad') +
  usersrc(map) +
  MCAUSER('_mq_chl_aws') +
