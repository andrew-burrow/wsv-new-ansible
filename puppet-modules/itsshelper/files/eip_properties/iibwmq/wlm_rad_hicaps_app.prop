WLM_LIST=(HICAPS HICAPS_TCPIP)

declare -A WLM_POLICY_NAME ADDITIONAL_INSTANCES

for WLM in ${WLM_LIST[*]} ; do
  WLM_POLICY_NAME[${WLM}]=WLM_${WLM}
done

case "${env}" in
  "sv1" | "pr1")
    ADDITIONAL_INSTANCES[HICAPS]=10
    ADDITIONAL_INSTANCES[HICAPS_TCPIP]=5
    ;;
  *)
    ADDITIONAL_INSTANCES[HICAPS]=10
    ADDITIONAL_INSTANCES[HICAPS_TCPIP]=5
    ;;
esac
