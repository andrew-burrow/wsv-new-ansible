* runmqsc command file template
* avanti_apps.template
* relies on avanti_apps.template.map

* ---------------------------------------------------
* Create client channel for Avanti application
define chl(AVANTI.__QMGRNAME__) -
        chltype(svrconn) -
        descr('Avanti connects to QM via this channel') -
        trptype(tcp) -
        mcauser('__AVANTIUSER__') -
        maxinst(20) -
        replace

* Create client channel for QM administration
define chl(ADMIN.MQEXP) -
	chltype(svrconn) -
	descr('Administer QM via this channel') -
	trptype(tcp) -
	mcauser('mqnoaccess') -
	maxinst(20) -
	replace

* ADMIN Client -> Authenticated user
set chlauth('ADMIN.MQEXP') -
	type(addressmap) -
	chckclnt(required) -
	address('*') -
	usersrc(map) -
	mcauser('MQADMIN') -
    action(replace)

* ADMIN Client -> Allow admin users
set chlauth('ADMIN.MQEXP') -
        type(blockuser) -
        userlist('mqnoaccess')

* Allow Avanti application access by user
* Access to qmgr
set authrec -
        objtype(qmgr) -
        principal('__AVANTIUSER__') -
        authrmv(all) -
        authadd(connect, -
                dsp, -
                inq)

set authrec -
        objtype(queue) -
        profile('EXT.TES.**') -
        principal('__AVANTIUSER__') -
        authrmv(all) -
        authadd(browse, -
                chg, -
                clr, -
                crt, -
                dlt, -
                dsp, -
                get, -
                put, -
                inq)

set authrec -
        objtype(queue) -
        profile('FIN.**') -
        principal('__AVANTIUSER__') -
        authrmv(all) -
        authadd(browse, -
                chg, -
                clr, -
                crt, -
                dlt, -
                dsp, -
                get, -
                put, -
                inq)

set authrec -
        objtype(queue) -
        profile('TES.CPS.REPLY') -
        principal('_mq_clus') -
        authrmv(all) -
        authadd(put, setall)

set authrec -
        objtype(queue) -
        profile('TES.CPS.**') -
        principal('__AVANTIUSER__') -
        authrmv(all) -
        authadd(browse, -
                chg, -
                clr, -
                crt, -
                dlt, -
                dsp, -
                get, -
                put, -
                inq)

set authrec -
        objtype(queue) -
        profile('ECV.**') -
        principal('__AVANTIUSER__') -
        authrmv(all) -
        authadd(browse, -
                chg, -
                clr, -
                crt, -
                dlt, -
                dsp, -
                get, -
                put, -
                inq, -
                passall, -
                passid)

set authrec -
        objtype(queue) -
        profile('SYSTEM.MQCONTEXT.ADMIN.QUEUE') -
        principal('__AVANTIUSER__') -
        authadd(chg)

set authrec -
        objtype(queue) -
        profile('SYSTEM.DEFAULT.MODEL.QUEUE') -
        principal('__AVANTIUSER__') -
        authrmv(all) -
        authadd(get, dsp)

set authrec -
        objtype(queue) -
        profile('SYSTEM.ADMIN.COMMAND.QUEUE') -
        principal('__AVANTIUSER__') -
        authrmv(all) -
        authadd(put)


set authrec -
        objtype(queue) -
        profile('ECV.**') -
        principal('__MQCLUSUSER__') -
        authrmv(all) -
        authadd(put, setall, inq, dsp)

set authrec -
        objtype(queue) -
        profile('FIN.**') -
        principal('__MQCLUSUSER__') -
        authrmv(all) -
        authadd(put, setall, inq, dsp)

set authrec -
        objtype(queue) -
        profile('EXT.TES.**') -
        principal('__MQCLUSUSER__') -
        authrmv(all) -
        authadd(put, setall, inq, dsp)


DEFINE QLOCAL ('ECV.FIS.RECONCILE.BOQ') REPLACE
DEFINE QLOCAL ('ECV.FIS.RECONCILE') +
       BOTHRESH(1) +
       BOQNAME('ECV.FIS.RECONCILE.BOQ') +       
       REPLACE

DEFINE QLOCAL ('ECV.FIS.REPLY.BOQ') REPLACE
DEFINE QLOCAL ('ECV.FIS.REPLY') +
       BOTHRESH(1) +
       BOQNAME('ECV.FIS.REPLY.BOQ') +       
       REPLACE

DEFINE QLOCAL ('ECV.FIS.REQUEST.BOQ') REPLACE
DEFINE QLOCAL ('ECV.FIS.REQUEST') +
       BOTHRESH(1) +
       BOQNAME('ECV.FIS.REQUEST.BOQ') +       
       REPLACE

DEFINE QLOCAL ('EXT.TES.REQUEST') REPLACE
DEFINE QLOCAL ('FIN.DOCPROD.REPLY') REPLACE
DEFINE QLOCAL ('FIN.DOCPROD.REQUEST') REPLACE

DEFINE QLOCAL ('TES.CPS.REPLY') +
       BOTHRESH(1) +
       BOQNAME('TES.CPS.REPLY.BOQ') +
       REPLACE




