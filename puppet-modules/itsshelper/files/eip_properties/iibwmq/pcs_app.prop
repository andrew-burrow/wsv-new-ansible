# Relies on some exported environment variables:
# ENV
QMGR_TEMPLATE=${CONFIGDIR}/pcs_app.template
QMTYPE=Apps
CLUSTER=${ENV^^} # upper case
ENV=$CLUSTER
env=${ENV,,} # lower case
if [ -z "$HOST" ] ; then
	HOST=$(hostname)
fi
E=$(echo $HOST | cut -c 2 | tr "[:lower:]" "[:upper:]")
#large message
T=M
NUM=$(echo $HOST | cut -c 7-)
QMGRNAME=$(echo ${ENV}${E}${T}${NUM} | tr "[:lower:]" "[:upper:]")
QMHOST=$HOST

#
# Set the userids which will be assigned onto non-admin
# client channels
CLUSUSER=_mq_clus
#
# Customise the PCS user for prod vs non-prod.
# non-prod accounts have the suffix "_np"
# Recognise prod because of the 'p' in the 2nd character of the host name
if [ "$E" == "A" ] || [ "$E" == "P" ] ; then
	USERSUFFIX="_pr"
	USERPREFIX=""
else
	USERSUFFIX="_np"
	USERPREFIX=""
fi
PCSUSER=${USERPREFIX}mq_pcs${USERSUFFIX}

SSLPEER="OU=${ENV}\/IBM MQ Client, O=ITSS, L=Melbourne, ST=VIC, C=AU"

#CLWLPRTY set to route traffic to both systems equally by default
if [ "${NUM:0:2}" == "$HANSEN" ]; then
        QPRIORITY=0
else
        QPRIORITY=0
fi
