DEFINE QLOCAL(XMITQ.TS3TMA301) + 
   DESCR('Messages queued for TS3TMA301') +
   INITQ(SYSTEM.CHANNEL.INITQ) +
   MAXDEPTH(5000) +
   MAXMSGL(4194304) +
   MONQ(QMGR) +
   MSGDLVSQ(PRIORITY) +
   TRIGGER +
   NPMCLASS(HIGH) +
   TRIGDATA(TS2TG0201.TS3TMA301) +
   TRIGTYPE(FIRST) +
   USAGE(XMITQ) +
   REPLACE
*
DEFINE QREMOTE(TS3TMA301) +
   CLUSTER(TS2) +
   CLWLPRTY(0) +
   DEFBIND(NOTFIXED) +
   DESCR('Alias to allow reply messages to route to AWS') +
   RQMNAME(TS3TMA301) +
   RNAME(' ') +
   XMITQ(XMITQ.TS3TMA301) +
   REPLACE
*
DEFINE QREMOTE(CS.ACCTION.IVP.RESP) +
   CLUSTER(TS2) +
   CLWLPRTY(0) +
   DEFBIND(NOTFIXED) +
   DESCR('IVP queue for sending messages to AWS') +
   RQMNAME(TS3TMA301) +
   RNAME(CS.ACCTION.IVP.RESP) +
   XMITQ(XMITQ.TS3TMA301) +
   REPLACE
*
DEFINE CHANNEL(TS2TG0201.TS3TMA301) +
   CHLTYPE(SDR) +
   CONNAME('mq-ts3.icp.np.workcover.vic.gov.au(31464)') +
   DESCR('Send messages to AWS QM TS2TMA301') +
   DISCINT(6000) +
   HBINT(300) +
   LONGRTY(999999999) +
   LONGTMR(1200) +
   NPMSPEED(NORMAL) +
   SHORTRTY(10) +
   SHORTTMR(60) +
   SSLCIPH(TLS_RSA_WITH_AES_256_CBC_SHA256) +
   SSLPEER('CN=TS3TMA301, OU=IBM MQ QMgr, OU=*/TS3/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
   XMITQ(XMITQ.TS3TMA301) +
   REPLACE
*
DEFINE CHANNEL(TS3TMA301.TS2TG0201) +
   CHLTYPE(RCVR) +
   DESCR('AWS QM to Gateway Queue Manager in cluster TS2') +
   HBINT(300) +
   KAINT(AUTO) +
   MAXMSGL(4194304) +
   MCAUSER('mqnoaccess') +
   MONCHL(QMGR) +
   NPMSPEED(NORMAL) +
   PUTAUT(DEF) +
   SSLCAUTH(REQUIRED) +
   SSLCIPH(TLS_RSA_WITH_AES_256_CBC_SHA256) +
   SSLPEER('CN=TS3TMA301, OU=IBM MQ QMgr, OU=*/TS3/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
   USEDLQ(YES) +
   REPLACE
*
SET CHLAUTH(TS2TG0201.TS3TMA301) +
   TYPE(SSLPEERMAP) +
   DESCR('Map AWS QMGR NAME from CN allowed') +
   SSLPEER('CN=TS3TMA301, OU=IBM MQ QMgr, OU=*/TS3/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
   SSLCERTI('CN=WINVMCA1, DC=melb, DC=ad') +
   ADDRESS(' ') +
   USERSRC(CHANNEL) +
   ACTION(REPLACE)
*
SET CHLAUTH(TS2TG0201.TS3TMA301) +
   TYPE(SSLPEERMAP) +
   DESCR('Map any other cert to NOACCESS') +
   SSLPEER(' ') +
   SSLCERTI(' ') +
   ADDRESS(' ') +
   USERSRC(NOACCESS) +
   ACTION(REPLACE)
*
SET CHLAUTH(TS3TMA301.TS2TG0201) +
   TYPE(SSLPEERMAP) +
   DESCR('Map AWS QMGR NAME from CN to a user') +
   SSLPEER('CN=TS3TMA301, OU=IBM MQ QMgr, OU=*/TS3/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
   SSLCERTI('CN=WINVMCA1, DC=melb, DC=ad') +
   ADDRESS(' ') +
   MCAUSER('_mq_chl_aws') +
   USERSRC(MAP) +
   ACTION(REPLACE)
*
SET CHLAUTH(TS3TMA301.TS2TG0201) +
   TYPE(SSLPEERMAP) +
   DESCR('Map any other cert to NOACCESS') +
   SSLPEER(' ') +
   SSLCERTI(' ') +
   ADDRESS(' ') +
   USERSRC(NOACCESS) +
   ACTION(REPLACE)
*
SET CHLAUTH(TS3TMA301.TS2TG0201) +
   TYPE(QMGRMAP) +
   DESCR('Map AWS QMGR NAME to a user') +
   ADDRESS(' ') +
   QMNAME(TS3TMA301) +
   MCAUSER('_mq_chl_aws') +
   USERSRC(MAP) +
   ACTION(REPLACE)
