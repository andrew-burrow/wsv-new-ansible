WLM_LIST=(InvoiceManagement CalculateInvoiceRatePayable CommonEmail AllocateExceptions_VWA AllocateExceptions_TAC Agent DrugGroupApproval Employer InjuredWorker Invoice InvoiceLineItem InvoiceRules Payee PracticeLocation Provider ProviderAgreement ReferenceData ServiceItem ServiceLimit TEMPUSBatch_Extract TEMPUSBatch_Load TransportAccidentClaim WorkInjuryClaim Workplace AcctionReplica AcctionReplicaAgent AcctionReplicaClaim AcctionReplicaProvider AcctionReplicaServiceItem Avanti CPS_CASS CPS_TAPS CPS_TIFS Novus TPCRepository TPCBatch_Extract TPCBatch_Load Scheduler ValidateClaim ClaimRules)

declare -A WLM_POLICY_NAME ADDITIONAL_INSTANCES

for WLM in ${WLM_LIST[*]} ; do
  WLM_POLICY_NAME[${WLM}]=WLM_${WLM}
done

case "${env}" in
  "sv1" | "pr1") 
    ADDITIONAL_INSTANCES[InvoiceManagement]=3
    ADDITIONAL_INSTANCES[CalculateInvoiceRatePayable]=3
