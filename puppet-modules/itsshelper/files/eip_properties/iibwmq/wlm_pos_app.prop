WLM_LIST=(Employer InjuredWorker Invoice InvoiceLineItem Payee PracticeLocation Provider ReferenceData ServiceItem ServiceLimit TransportAccidentClaim WorkInjuryClaim Workplace AcctionReplica AcctionReplicaClaim AcctionReplicaProvider AcctionReplicaServiceItem Avanti CPS_CASS CPS_TAPS CPS_TIFS TPCRepository)

declare -A WLM_POLICY_NAME ADDITIONAL_INSTANCES

for WLM in ${WLM_LIST[*]} ; do
  WLM_POLICY_NAME[${WLM}]=WLM_${WLM}
done

case "${env}" in
  "sv1" | "pr1") 
    ADDITIONAL_INSTANCES[Employer]=2
    ADDITIONAL_INSTANCES[InjuredWorker]=2
    ADDITIONAL_INSTANCES[Invoice]=2
    ADDITIONAL_INSTANCES[InvoiceLineItem]=2
    ADDITIONAL_INSTANCES[Payee]=2
    ADDITIONAL_INSTANCES[PracticeLocation]=2
    ADDITIONAL_INSTANCES[Provider]=2
    ADDITIONAL_INSTANCES[ReferenceData]=2
    ADDITIONAL_INSTANCES[ServiceItem]=2
    ADDITIONAL_INSTANCES[ServiceLimit]=2
    ADDITIONAL_INSTANCES[TransportAccidentClaim]=2
    ADDITIONAL_INSTANCES[WorkInjuryClaim]=2
    ADDITIONAL_INSTANCES[Workplace]=2
    ADDITIONAL_INSTANCES[AcctionReplica]=2
    ADDITIONAL_INSTANCES[AcctionReplicaClaim]=2
    ADDITIONAL_INSTANCES[AcctionReplicaProvider]=2
    ADDITIONAL_INSTANCES[AcctionReplicaServiceItem]=2
    ADDITIONAL_INSTANCES[Avanti]=2
    ADDITIONAL_INSTANCES[CPS_CASS]=2
    ADDITIONAL_INSTANCES[CPS_TAPS]=2
    ADDITIONAL_INSTANCES[CPS_TIFS]=2
    ADDITIONAL_INSTANCES[TPCRepository]=2
    ;;
  *) 
    ADDITIONAL_INSTANCES[Employer]=2
    ADDITIONAL_INSTANCES[InjuredWorker]=2
    ADDITIONAL_INSTANCES[Invoice]=2
    ADDITIONAL_INSTANCES[InvoiceLineItem]=2
    ADDITIONAL_INSTANCES[Payee]=2
    ADDITIONAL_INSTANCES[PracticeLocation]=2
    ADDITIONAL_INSTANCES[Provider]=2
    ADDITIONAL_INSTANCES[ReferenceData]=2
    ADDITIONAL_INSTANCES[ServiceItem]=2
    ADDITIONAL_INSTANCES[ServiceLimit]=2
    ADDITIONAL_INSTANCES[TransportAccidentClaim]=2
    ADDITIONAL_INSTANCES[WorkInjuryClaim]=2
    ADDITIONAL_INSTANCES[Workplace]=2
    ADDITIONAL_INSTANCES[AcctionReplica]=2
    ADDITIONAL_INSTANCES[AcctionReplicaClaim]=2
    ADDITIONAL_INSTANCES[AcctionReplicaProvider]=2
    ADDITIONAL_INSTANCES[AcctionReplicaServiceItem]=2
    ADDITIONAL_INSTANCES[Avanti]=2
    ADDITIONAL_INSTANCES[CPS_CASS]=2
    ADDITIONAL_INSTANCES[CPS_TAPS]=2
    ADDITIONAL_INSTANCES[CPS_TIFS]=2
    ADDITIONAL_INSTANCES[TPCRepository]=2
    ;;
esac

