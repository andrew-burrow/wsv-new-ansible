* Alter channels and define chlauth
* to permit CI1 AWS queue manager
* CI1DMA101 to connect using a DV1
* certificate.
 
alter chl(CI1DG0101.CI1DMA101) +
  chltype(sdr) +
  sslpeer('CN=*, OU=IBM MQ QMgr, OU=*, O=ITSS, L=Geelong, S=VIC, C=AU')
*
set chlauth(CI1DG0101.CI1DMA101) +
  type(sslpeermap) +
  descr('Map AWS QMGR NAME from CN allowed') +
  sslpeer('CN=DV1DMA201, OU=IBM MQ QMgr, OU=*/DV1/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
  sslcerti('CN=WINVMCA1, DC=melb, DC=ad') +
  usersrc(channel) +
  action(replace)
*
set chlauth(CI1DG0101.CI1DMA101) +
  type(sslpeermap) +
  descr('Map AWS QMGR NAME from CN allowed') +
  sslpeer('CN=CI1DMA101, OU=IBM MQ QMgr, OU=*/CI1/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
  sslcerti('CN=WINVMCA1, DC=melb, DC=ad') +
  usersrc(channel) +
  action(replace)
*
alter chl(CI1DMA101.CI1DG0101) +
  chltype(rcvr) +
  sslpeer('CN=*, OU=IBM MQ QMgr, OU=*, O=ITSS, L=Geelong, S=VIC, C=AU')
*
set chlauth(CI1DMA101.CI1DG0101) +
  type(sslpeermap) +
  descr('Map AWS QMGR NAME from CN allowed') +
  sslpeer('CN=DV1DMA201, OU=IBM MQ QMgr, OU=*/DV1/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
  sslcerti('CN=WINVMCA1, DC=melb, DC=ad') +
  usersrc(map) +
  MCAUSER('_mq_chl_aws') +
  action(replace)
*
set chlauth(CI1DMA101.CI1DG0101) +
  type(sslpeermap) +
  descr('Map AWS QMGR NAME from CN allowed') +
  sslpeer('CN=CI1DMA101, OU=IBM MQ QMgr, OU=*/CI1/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
  sslcerti('CN=WINVMCA1, DC=melb, DC=ad') +
  usersrc(map) +
  MCAUSER('_mq_chl_aws') +
  action(replace)