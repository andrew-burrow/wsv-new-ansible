WLM_LIST=(Document DocumentManagement AvantiDocument EFile)

declare -A WLM_POLICY_NAME ADDITIONAL_INSTANCES

for WLM in ${WLM_LIST[*]} ; do
  WLM_POLICY_NAME[${WLM}]=WLM_${WLM}
done

case "${env}" in
  "sv1" | "pr1") 
    ADDITIONAL_INSTANCES[Document]=2
    ADDITIONAL_INSTANCES[DocumentManagement]=2
    ADDITIONAL_INSTANCES[AvantiDocument]=2
    ADDITIONAL_INSTANCES[EFile]=2
    ;;
  *) 
    ADDITIONAL_INSTANCES[Document]=2
    ADDITIONAL_INSTANCES[DocumentManagement]=2
    ADDITIONAL_INSTANCES[AvantiDocument]=2
    ADDITIONAL_INSTANCES[EFile]=2
    ;;
esac

