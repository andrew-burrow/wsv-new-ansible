WLM_LIST=(PremiumRules CalculatePremium PremiumParameters PremiumReference PremiumTransaction PricingPeriod PCSRepository PCSTransactionRepository)

declare -A WLM_POLICY_NAME ADDITIONAL_INSTANCES

for WLM in ${WLM_LIST[*]} ; do
  WLM_POLICY_NAME[${WLM}]=WLM_${WLM}
done

case "${env}" in
  "sv1" | "pr1") 
    ADDITIONAL_INSTANCES[PremiumRules]=2
    ADDITIONAL_INSTANCES[CalculatePremium]=2
    ADDITIONAL_INSTANCES[PremiumParameters]=2
    ADDITIONAL_INSTANCES[PremiumReference]=2
    ADDITIONAL_INSTANCES[PremiumTransaction]=2
    ADDITIONAL_INSTANCES[PricingPeriod]=2
    ADDITIONAL_INSTANCES[PCSRepository]=2
    ADDITIONAL_INSTANCES[PCSTransactionRepository]=2
    ;;
  *) 
    ADDITIONAL_INSTANCES[PremiumRules]=2
    ADDITIONAL_INSTANCES[CalculatePremium]=2
    ADDITIONAL_INSTANCES[PremiumParameters]=2
    ADDITIONAL_INSTANCES[PremiumReference]=2
    ADDITIONAL_INSTANCES[PremiumTransaction]=2
    ADDITIONAL_INSTANCES[PricingPeriod]=2
    ADDITIONAL_INSTANCES[PCSRepository]=2
    ADDITIONAL_INSTANCES[PCSTransactionRepository]=2
    ;;
esac
