# Relies on some exported environment variables:
# ENV
QMGR_TEMPLATE=${CONFIGDIR}/rat_iib_app.template
QMTYPE=Apps
CLUSTER=${ENV^^} # upper case
env=${ENV,,} # lower case
if [ -z "$HOST" ] ; then
        HOST=$(hostname)
fi
E=$(echo $HOST | cut -c 2 | tr "[:lower:]" "[:upper:]")
T=$(echo $HOST | cut -c 5 | tr "[:lower:]" "[:upper:]")
NUM=$(echo $HOST | cut -c 7-)
QMGRNAME=$(echo ${ENV}${E}${T}${NUM} | tr "[:lower:]" "[:upper:]")
QMHOST=$HOST

# Generate VWA mainframe name from environment mapping
VWA_MF_QMGR=""
case ${env} in
	"dv1")
		VWA_MF_QMGR=V209
		;;
	"ts1") 
		VWA_MF_QMGR=V128 
		;;
	"ts2") 
		VWA_MF_QMGR=V129 
		;;
	"tr1") 
		VWA_MF_QMGR=V213 
		;;
	"sv1") 
		VWA_MF_QMGR=V211 
		;;
	"pr1") 
		VWA_MF_QMGR=V210 
		;;
	*) 
		VWA_MF_QMGR="dummy" 
		;;
esac

#
# Set the userids which will be assigned onto non-admin
# client channels
EXHIBITION="02"
HANSEN="01"
CLUSUSER=_mq_clus
