# Relies on exported environment variable:
# ENV
# Requires config file
#  mqrepo.properties
# Get the mapping from queue managers to Full Repository QMs
REPOLIST=${CONFIGDIR}/mqrepo.properties
. $REPOLIST
QMGR_TEMPLATE=${CONFIGDIR}/apps_ssl.template
HOST=$(hostname)
E=$(echo $HOST | cut -c 2 | tr "[:lower:]" "[:upper:]")
T=$(echo $HOST | cut -c 5 | tr "[:lower:]" "[:upper:]")
NUM=$(echo $HOST | cut -c 7-)
QMGRNAME=$(echo ${ENV}${E}${T}${NUM} | tr "[:lower:]" "[:upper:]")
REPOQM=${MQREPOSLIST[${QMGRNAME}]}
REPOENV=$(echo $REPOQM | cut -c 4)
REPONUM=$(echo $REPOQM | cut -c 6-)
REPOPREFIX=$(echo $REPOQM | cut -c 1-5)
REPOHOST=$(echo s${REPOENV}uwmq${REPONUM}-${ENV} | tr "[:upper:]" "[:lower:]")
SHORTPREFIX=$(echo $QMGRNAME | cut -c 1-4)
CLUSTER=${ENV^^} # upper case
env=${ENV,,} # lower case
#
#
#
# Set the userids which will be assigned onto message channels and non-admin
# client channels
CLUSUSER=_mq_clus
REPOUSER=_mq_repos
