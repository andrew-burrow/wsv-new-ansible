* ---------------------------------------------------
* Define Queues - SC_EIPmyTAC_Outbound
* ---------------------------------------------------

define ql('SC.EIPMYTACOUTBOUNDDOC.RESP.V1') -
    descr('Response Queue for SC_EIPmyTAC_Outbound') -
    replace


* ---------------------------------------------------
* Define Queues - SC_OnlineFormDocuments
* ---------------------------------------------------

define ql('SC.ONLINE.FORM.DOCUMENTS.REQ.BOQ.V1') -
    descr('Backout Queue for SC_OnlineFormDocuments') -
    replace

define ql('SC.ONLINE.FORM.DOCUMENTS.REQ.V1') -
    descr('Request Queue for SC_OnlineFormDocuments') -
    boqname('SC.ONLINE.FORM.DOCUMENTS.REQ.BOQ.V1') -
    bothresh(3) -
    replace

define ql('SC.ONLINE.FORM.DOCUMENTS.EX.V1') -
    descr('Exception Queue for any failures in SC_OnlineFormDocuments') -
    replace

* ---------------------------------------------------
* Define Queues - ES_FormDocuments
* ---------------------------------------------------

define ql('ES.FORM.DOCUMENTS.REQ.BOQ.V1') -
    descr('Backout Queue for ES_FormDocuments') -
    replace

define ql('ES.FORM.DOCUMENTS.REQ.V1') -
    descr('Request Queue for ES_FormDocuments') -
    boqname('ES.FORM.DOCUMENTS.REQ.BOQ.V1') -
    bothresh(3) -
    replace

define ql('ES.FORM.DOCUMENTS.RESP.V1') -
    descr('Response Queue for ES_FormDocuments') -
    replace


* ---------------------------------------------------
* Refresh security to activate the new rules
refresh security(*) type(authserv)
