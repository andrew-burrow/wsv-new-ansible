* ---------------------------------------------------
* Set Auth Records - Service Component Queues
* ---------------------------------------------------

set authrec -
    objtype(queue) -
    profile('SC.EIPMYTACOUTBOUNDDOC.**') -
    principal('__IIBUSER__') -
    authrmv(all) -
    authadd(browse, get, inq, put, setall, setid, passall, passid, dsp)
 
set authrec -
    objtype(queue) -
    profile('SC.EIPMYTACOUTBOUNDDOC.**') -
    principal('__CLUSUSER__') -
    authrmv(all) -
    authadd(put, inq, setall)

set authrec -
    objtype(queue) -
    profile('SC.ONLINE.FORM.DOCUMENTS.**') -
    principal('__IIBUSER__') -
    authrmv(all) -
    authadd(browse, get, inq, put, setall, setid, passall, passid, dsp)
 
set authrec -
    objtype(queue) -
    profile('SC.ONLINE.FORM.DOCUMENTS.**') -
    principal('__CLUSUSER__') -
    authrmv(all) -
    authadd(put, inq, setall)


