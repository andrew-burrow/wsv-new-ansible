# Relies on some exported environment variables:
# ENV
QMGR_TEMPLATE=${CONFIGDIR}/gwy_app.template
QMTYPE=Gateway
CLUSTER=${ENV^^} # upper case
ENV=$CLUSTER
env=${ENV,,} # lower case
if [ -z "$HOST" ] ; then
    HOST=$(hostname)
fi
E=$(echo $HOST | cut -c 2 | tr "[:lower:]" "[:upper:]")
#gateway qmgr
T=G
NUM=$(echo $HOST | cut -c 7-)
QMGRNAME=$(echo ${ENV}${E}${T}${NUM} | tr "[:lower:]" "[:upper:]")
QMHOST=$HOST
GWYMAP=${CONFIGDIR}/mqgateway.properties
source $GWYMAP
AWSQM=${MQGWYLIST[${QMGRNAME}]}

# Configuration to allow responses from ACE AWS to be routed 
# back to on-prem IIB
GWYQMPREFIX=$(echo ${QMGRNAME} | cut -c -4 )
IIBQM1="${GWYQMPREFIX}I0101"
IIBQM2="${GWYQMPREFIX}I0201"

# Configure the Long, Upper Case environment name (LUENV)
# Import the mapping file, then declare the variable
MQENVMAP=${CONFIGDIR}/mqenvironments.properties
source $MQENVMAP
LUENV=${MQEnvMap[$E]}
#
#
MONITORUSER=_mq_monitor
CLUSUSER=_mq_clus
REPOUSER=_mq_repos
APPUSER=_mq_clus_app
MFUSER=_mq_clus_mf
IIBUSER=_mq_clus_iib
RATUSER=_mq_clus_ibr
AWSUSER=_mq_chl_aws

#
# Define site specific host values
EXHIBITION="02"
HANSEN="01"

HOSTSITE=${NUM:0:2}
if [ "$HOSTSITE" = "$HANSEN" ] ; then
    QLOCATION="HANSEN"
    QPRTY=5
else
    QLOCATION="EXHIBITION"
    QPRTY=0
fi
