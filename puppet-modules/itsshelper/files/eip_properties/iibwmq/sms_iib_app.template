* ---------------------------------------------------
* Define Queues - CS_NACMessagingService
* ---------------------------------------------------

define ql('CS.NAC.MESSAGINGSERVICE.BOQ.V1') -
 descr('Backout queue for CS_NACMessagingService') -
 replace
  
define ql('CS.NAC.MESSAGINGSERVICE.REQ.V1') -
 descr('Request queue for CS_NACMessagingService') -
 cluster(__CLUSNAME__) -
 clwlprty(__QPRIORITY__) -
 boqname('CS.NAC.MESSAGINGSERVICE.BOQ.V1') -
 bothresh(1) -
 replace
 
define ql('CS.NAC.MESSAGINGSERVICE.RESP.V1') -
 descr('Replies to CS_NACMessagingService') -
 replace
  
