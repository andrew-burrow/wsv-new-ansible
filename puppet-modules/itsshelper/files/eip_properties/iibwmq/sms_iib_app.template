* ---------------------------------------------------
* Set Auth Records - Consumer Service Queues
* ---------------------------------------------------
 
set authrec -
 objtype(queue) -
 profile('CS.NAC.MESSAGINGSERVICE.**') -
 principal('__IIBUSER__') -
 authrmv(all) -
 authadd(browse, get, inq, put, setall, setid, passall, passid, dsp)
 
set authrec -
 objtype(queue) -
 profile('CS.NAC.MESSAGINGSERVICE.**') -
 principal('__CLUSUSER__') -
 authrmv(all) -
 authadd(put, inq, setall)

