# Relies on some exported environment variables:
# ENV
# QMGR TYPE: application (M)

QMGR_TEMPLATE_COMMON=${CONFIGDIR}/${PROPNAME}.template.common
QMGR_TEMPLATE=${CONFIGDIR}/${PROPNAME}.template
QMTYPE=Apps
CLUSTER=${ENV^^} # upper case
env=${ENV,,} # lower case
if [ -z "$HOST" ] ; then
        HOST=$(hostname)
fi
E=$(echo $HOST | cut -c 2 | tr "[:lower:]" "[:upper:]")
T=$(echo $HOST | cut -c 5 | tr "[:lower:]" "[:upper:]")
NUM=$(echo $HOST | cut -c 7-)
QMGRNAME=$(echo ${ENV}${E}${T}${NUM} | tr "[:lower:]" "[:upper:]")
QMHOST=$HOST

#
# Set the userids which will be assigned onto non-admin
# client channels
AVANTIUSER=_mq_avanti
EXHIBITION="02"
HANSEN="01"
CLUSUSER=_mq_clus

#used in QR definition for Avanti
TAC_MF_QMGR=""
AVANTI_EVN=""
#TAC_MF_PORT=1412
#TAC_MF_IP=10.30.6.194
case ${env} in
	"ts3") 
		TAC_MF_QMGR=MQAD
		AVANTI_ENV=UAT3
		;;
	"ps1") 
		TAC_MF_QMGR=MQAQ
		AVANTI_ENV=UAT2
		;;
	"ts2") 
		TAC_MF_QMGR=MQA3 
		AVANTI_ENV=UAT1
		;;
	"ts1") 
		TAC_MF_QMGR=MQA7 
		AVANTI_ENV=SYT3
		;;
	"pr1") 
		TAC_MF_QMGR=MQCP 
		AVANTI_ENV=PROD
		;;
	"dv1") 
		TAC_MF_QMGR=MQA2 
		AVANTI_ENV=POT
		;;
	*) 
		TAC_MF_QMGR="dummy" 
		AVANTI_ENV="dummy"
		;;
esac

#Create Avanti queues according to environment
AVANTIENV1="NA"
AVANTIENV2="NA"
AVANTIENV3="NA"
AVANTIENV4="NA"
AVANTIENV5="NA"

case ${QMGRNAME} in
	"DV1DM0101")
		AVANTIENV1=STG1
		AVANTIENV2=STG2
		AVANTIENV3=STG3
		AVANTIENV4=STG4
		AVANTIENV5=STG5
		;;
	"DV1DM0201")
		AVANTIENV1=MAS1
		AVANTIENV2=MAS2
		AVANTIENV3=SPT1
		AVANTIENV4=SPT2
		AVANTIENV5=SPT3
		;;
	"SP3XM0102" | "TS1TM0101")
		AVANTIENV1=SYT1
		AVANTIENV2=SYT1
		AVANTIENV3=SYT1
		AVANTIENV4=SYT1
		AVANTIENV5=SYT1
		;;
	"TS2TM0101")
		AVANTIENV1=SYT2
		AVANTIENV2=SYT2
		AVANTIENV3=SYT2
		AVANTIENV4=SYT2
		AVANTIENV5=SYT2
		;;
	"TS3TM0101")
		AVANTIENV1=SYT3
		AVANTIENV2=SYT3
		AVANTIENV3=SYT3
		AVANTIENV4=SYT3
		AVANTIENV5=SYT3
		;;
	"TS1TM0201")
		AVANTIENV1=UAT1
		AVANTIENV2=UAT1
		AVANTIENV3=UAT1
		AVANTIENV4=UAT1
		AVANTIENV5=UAT1
		;;
	"TS2TM0201")
		AVANTIENV1=UAT2
		AVANTIENV2=UAT2
		AVANTIENV3=UAT2
		AVANTIENV4=UAT2
		AVANTIENV5=UAT2
		;;
	"TS3TM0201")
		AVANTIENV1=UAT3
		AVANTIENV2=UAT3
		AVANTIENV3=UAT3
		AVANTIENV4=UAT3
		AVANTIENV5=UAT3
		;;
	"PS1DM0101")
		AVANTIENV1=PSUP
		AVANTIENV2=PSUP
		AVANTIENV3=PSUP
		AVANTIENV4=PSUP
		AVANTIENV5=PSUP
		;;
	"CI1DM0101")
		AVANTIENV1=DRL1
		AVANTIENV2=DRL1
		AVANTIENV3=DRL1
		AVANTIENV4=DRL1
		AVANTIENV5=DRL1
		;;
	"SP1XM0101")
		AVANTIENV1=POT1
		AVANTIENV2=POT1
		AVANTIENV3=POT1
		AVANTIENV4=POT1
		AVANTIENV5=POT1
		;;
	"SV1VM0101")
		AVANTIENV1=SVT1
		AVANTIENV2=SVT1
		AVANTIENV3=SVT1
		AVANTIENV4=SVT1
		AVANTIENV5=SVT1
		;;
	"PA1AM0101")
		AVANTIENV1=PAT1
		AVANTIENV2=TRN1
		AVANTIENV3=TRN1
		AVANTIENV4=TRN1
		AVANTIENV5=TRN1
		;;
	"PR1PM0101")
		AVANTIENV1=PRD1
		AVANTIENV2=PRD1
		AVANTIENV3=PRD1
		AVANTIENV4=PRD1
		AVANTIENV5=PRD1
		;;
esac


#setup template
cp ${QMGR_TEMPLATE_COMMON} ${QMGR_TEMPLATE}

if [ "${TAC_MF_QMGR}" != "dummy" ]; then
	cat ${QMGR_TEMPLATE}.tac >> ${QMGR_TEMPLATE}
fi

#case ${E} in
#	"P")
#		cat ${QMGR_TEMPLATE}.prod >> ${QMGR_TEMPLATE}
#;;
#	*)
#		cat ${QMGR_TEMPLATE}.np >> ${QMGR_TEMPLATE}
#		;;
#esac

#Avanti queues are specific to Qmgrs
case ${QMGRNAME} in
	"PR1PM0101")
		cat ${QMGR_TEMPLATE}.prod >> ${QMGR_TEMPLATE}
		;;
	"DV1DM0101" | "DV1DM0201" | "SP3XM0102" | "TS1TM0101" | "TS2TM0101" | "TS3TM0101" | "TS1TM0201" | "TS2TM0201" | "TS3TM0201" | "PS1DM0101" | "CI1DM0101" | "SP1XM0101" | "SV1VM0101" | "PA1AM0101" | "PR1PM0101")
		cat ${QMGR_TEMPLATE}.np >> ${QMGR_TEMPLATE}
		;;
esac
