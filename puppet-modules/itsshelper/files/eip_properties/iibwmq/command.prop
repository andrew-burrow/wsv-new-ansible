# Relies on some exported environment variables:
HOST=$(hostname)
E=$(echo $HOST | cut -c 2 | tr "[:lower:]" "[:upper:]")
T=$(echo $HOST | cut -c 5 | tr "[:lower:]" "[:upper:]")
NUM=$(echo $HOST | cut -c 7-)
QMGRNAME=$(echo ${ENV}${E}${T}${NUM} | tr "[:lower:]" "[:upper:]")
QMTYPE=$QMGRNAME
QMGR_TEMPLATE=${CONFIGDIR}/command.template
EVENTTYPE=COMMAND
EVENTQUEUE=AUDIT.COMMAND
# substitutions require the '/' to be escaped
EVENTFILE=\\/var\\/spool\\/IBM\\/mqm\\/${QMGRNAME}_command.log
