WLM_LIST=(AdjudicationRules AdjudicationAvanti AdjudicationRepository)

declare -A WLM_POLICY_NAME ADDITIONAL_INSTANCES

for WLM in ${WLM_LIST[*]} ; do
  WLM_POLICY_NAME[${WLM}]=WLM_${WLM}
done

case "${env}" in
  "sv1" | "pr1") 
    ADDITIONAL_INSTANCES[AdjudicationRules]=2
    ADDITIONAL_INSTANCES[AdjudicationAvanti]=2
    ADDITIONAL_INSTANCES[AdjudicationRepository]=2
    ;;
  *) 
    ADDITIONAL_INSTANCES[AdjudicationRules]=2
    ADDITIONAL_INSTANCES[AdjudicationAvanti]=2
    ADDITIONAL_INSTANCES[AdjudicationRepository]=2
    ;;
esac

