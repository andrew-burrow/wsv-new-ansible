WLM_LIST=(TACGL GeneralLedger OracleFinEIPRepository VPCSGL ACCTION_GL PayrollGL OracleProcessStatus OracleJob OracleProject TACProjects AurionProjects DaptiveProjects EmployeeUpdates)

declare -A WLM_POLICY_NAME ADDITIONAL_INSTANCES

for WLM in ${WLM_LIST[*]} ; do
  WLM_POLICY_NAME[${WLM}]=WLM_${WLM}
done

case "${env}" in
  "sv1" | "pr1") 
    ADDITIONAL_INSTANCES[TACGL]=2
	ADDITIONAL_INSTANCES[VPCSGL]=2
	ADDITIONAL_INSTANCES[PayrollGL]=2
	ADDITIONAL_INSTANCES[ACCTION_GL]=2
    ADDITIONAL_INSTANCES[GeneralLedger]=2
	ADDITIONAL_INSTANCES[OracleFinEIPRepository]=2
	ADDITIONAL_INSTANCES[OracleProcessStatus]=2
	ADDITIONAL_INSTANCES[OracleJob]=2
	ADDITIONAL_INSTANCES[OracleProject]=2
	ADDITIONAL_INSTANCES[TACProjects]=2
	ADDITIONAL_INSTANCES[AurionProjects]=2
	ADDITIONAL_INSTANCES[DaptiveProjects]=2
	ADDITIONAL_INSTANCES[EmployeeUpdates]=2
    ;;
  *) 
    ADDITIONAL_INSTANCES[TACGL]=2
	ADDITIONAL_INSTANCES[VPCSGL]=2
	ADDITIONAL_INSTANCES[PayrollGL]=2
	ADDITIONAL_INSTANCES[ACCTION_GL]=2
    ADDITIONAL_INSTANCES[GeneralLedger]=2
	ADDITIONAL_INSTANCES[OracleFinEIPRepository]=2
	ADDITIONAL_INSTANCES[OracleProcessStatus]=2
	ADDITIONAL_INSTANCES[OracleJob]=2
	ADDITIONAL_INSTANCES[OracleProject]=2
	ADDITIONAL_INSTANCES[TACProjects]=2
	ADDITIONAL_INSTANCES[AurionProjects]=2
	ADDITIONAL_INSTANCES[DaptiveProjects]=2
    ADDITIONAL_INSTANCES[EmployeeUpdates]=2
	;;
esac

