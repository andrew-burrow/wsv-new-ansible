# Relies on some exported environment variables:
# ENV
QMGR_TEMPLATE=${CONFIGDIR}/novus_app.template
QMTYPE=Apps
CLUSTER=${ENV^^} # upper case
env=${ENV,,} # lower case
if [ -z "$HOST" ] ; then
        HOST=$(hostname)
fi
E=$(echo $HOST | cut -c 2 | tr "[:lower:]" "[:upper:]")
T=$(echo $HOST | cut -c 5 | tr "[:lower:]" "[:upper:]")
NUM=$(echo $HOST | cut -c 7-)
QMGRNAME=$(echo ${ENV}${E}${T}${NUM} | tr "[:lower:]" "[:upper:]")
QMHOST=$HOST

#
# Set the userids which will be assigned onto non-admin
# client channels
NOVUSUSER=_mq_novus
EXHIBITION="02"
HANSEN="01"
CLUSUSER=_mq_clus
#CLWLRANK set to route traffic to EXHIBITION queues
if [ "${NUM:0:2}" == "$HANSEN" ]; then
        QRANK=0
else
        QRANK=5
fi
