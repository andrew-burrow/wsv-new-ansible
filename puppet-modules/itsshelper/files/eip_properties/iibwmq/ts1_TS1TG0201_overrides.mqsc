DEFINE QLOCAL(XMITQ.TS4TMA201) + 
   DESCR('Messages queued for TS4TMA201') +
   INITQ(SYSTEM.CHANNEL.INITQ) +
   MAXDEPTH(5000) +
   MAXMSGL(4194304) +
   MONQ(QMGR) +
   MSGDLVSQ(PRIORITY) +
   TRIGGER +
   NPMCLASS(HIGH) +
   TRIGDATA(TS1TG0201.TS4TMA201) +
   TRIGTYPE(FIRST) +
   USAGE(XMITQ) +
   REPLACE
*
DEFINE QREMOTE(TS4TMA201) +
   CLUSTER(TS1) +
   CLWLPRTY(0) +
   DEFBIND(NOTFIXED) +
   DESCR('Alias to allow reply messages to route to AWS') +
   RQMNAME(TS4TMA201) +
   RNAME(' ') +
   XMITQ(XMITQ.TS4TMA201) +
   REPLACE
*
DEFINE QREMOTE(CS.ACCTION.IVP.RESP) +
   CLUSTER(TS1) +
   CLWLPRTY(0) +
   DEFBIND(NOTFIXED) +
   DESCR('IVP queue for sending messages to AWS') +
   RQMNAME(TS4TMA201) +
   RNAME(CS.ACCTION.IVP.RESP) +
   XMITQ(XMITQ.TS4TMA201) +
   REPLACE
*
DEFINE CHANNEL(TS1TG0201.TS4TMA201) +
   CHLTYPE(SDR) +
   CONNAME('mq-ts4.icp.np.workcover.vic.gov.au(31494)') +
   DESCR('Send messages to AWS QM TS4TMA201') +
   DISCINT(6000) +
   HBINT(300) +
   LONGRTY(999999999) +
   LONGTMR(1200) +
   NPMSPEED(NORMAL) +
   SHORTRTY(10) +
   SHORTTMR(60) +
   SSLCIPH(TLS_RSA_WITH_AES_256_CBC_SHA256) +
   SSLPEER('CN=TS4TMA201, OU=IBM MQ QMgr, OU=*/TS4/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
   XMITQ(XMITQ.TS4TMA201) +
   REPLACE
*
DEFINE CHANNEL(TS4TMA201.TS1TG0201) +
   CHLTYPE(RCVR) +
   DESCR('AWS QM to Gateway Queue Manager in cluster TS1') +
   HBINT(300) +
   KAINT(AUTO) +
   MAXMSGL(4194304) +
   MCAUSER('mqnoaccess') +
   MONCHL(QMGR) +
   NPMSPEED(NORMAL) +
   PUTAUT(DEF) +
   SSLCAUTH(REQUIRED) +
   SSLCIPH(TLS_RSA_WITH_AES_256_CBC_SHA256) +
   SSLPEER('CN=TS4TMA201, OU=IBM MQ QMgr, OU=*/TS4/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
   USEDLQ(YES) +
   REPLACE
*
SET CHLAUTH(TS1TG0201.TS4TMA201) +
   TYPE(SSLPEERMAP) +
   DESCR('Map AWS QMGR NAME from CN allowed') +
   SSLPEER('CN=TS4TMA201, OU=IBM MQ QMgr, OU=*/TS4/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
   SSLCERTI('CN=WINVMCA1, DC=melb, DC=ad') +
   ADDRESS(' ') +
   USERSRC(CHANNEL) +
   ACTION(REPLACE)
*
SET CHLAUTH(TS1TG0201.TS4TMA201) +
   TYPE(SSLPEERMAP) +
   DESCR('Map any other cert to NOACCESS') +
   SSLPEER(' ') +
   SSLCERTI(' ') +
   ADDRESS(' ') +
   USERSRC(NOACCESS) +
   ACTION(REPLACE)
*
SET CHLAUTH(TS4TMA201.TS1TG0201) +
   TYPE(SSLPEERMAP) +
   DESCR('Map AWS QMGR NAME from CN to a user') +
   SSLPEER('CN=TS4TMA201, OU=IBM MQ QMgr, OU=*/TS4/*, O=ITSS, L=Geelong, S=VIC, C=AU') +
   SSLCERTI('CN=WINVMCA1, DC=melb, DC=ad') +
   ADDRESS(' ') +
   MCAUSER('_mq_chl_aws') +
   USERSRC(MAP) +
   ACTION(REPLACE)
*
SET CHLAUTH(TS4TMA201.TS1TG0201) +
   TYPE(SSLPEERMAP) +
   DESCR('Map any other cert to NOACCESS') +
   SSLPEER(' ') +
   SSLCERTI(' ') +
   ADDRESS(' ') +
   USERSRC(NOACCESS) +
   ACTION(REPLACE)
*
SET CHLAUTH(TS4TMA201.TS1TG0201) +
   TYPE(QMGRMAP) +
   DESCR('Map AWS QMGR NAME to a user') +
   ADDRESS(' ') +
   QMNAME(TS4TMA201) +
   MCAUSER('_mq_chl_aws') +
   USERSRC(MAP) +
   ACTION(REPLACE)
