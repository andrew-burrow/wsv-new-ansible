WLM_LIST=(ServiceNowIntegration SplunkEIPRepository)

declare -A WLM_POLICY_NAME ADDITIONAL_INSTANCES

for WLM in ${WLM_LIST[*]} ; do
  WLM_POLICY_NAME[${WLM}]=WLM_${WLM}
done

case "${env}" in
  "sv1" | "pr1") 
    ADDITIONAL_INSTANCES[ServiceNowIntegration]=10
    ADDITIONAL_INSTANCES[SplunkEIPRepository]=10
    ;;
  *) 
    ADDITIONAL_INSTANCES[ServiceNowIntegration]=5
    ADDITIONAL_INSTANCES[SplunkEIPRepository]=5
    ;;
esac

