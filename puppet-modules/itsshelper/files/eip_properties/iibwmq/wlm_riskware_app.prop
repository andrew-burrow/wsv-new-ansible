WLM_LIST=(AccrualPayrollGL AccrualProjects)

declare -A WLM_POLICY_NAME ADDITIONAL_INSTANCES

for WLM in ${WLM_LIST[*]} ; do
  WLM_POLICY_NAME[${WLM}]=WLM_${WLM}
done

case "${env}" in
  "sv1" | "pr1") 
	ADDITIONAL_INSTANCES[AccrualPayrollGL]=2
	ADDITIONAL_INSTANCES[AccrualProjects]=2
    ;;
  *) 
	ADDITIONAL_INSTANCES[AccrualPayrollGL]=2
	ADDITIONAL_INSTANCES[AccrualProjects]=2
	;;
esac

