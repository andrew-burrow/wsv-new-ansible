<?xml version='1.0' encoding='UTF-8'?>
<agent-input>
  <variables>
    <variable name='sharedLocation' value='/opt/IMShared'/>
  </variables>
  <server>
    <repository location='/opt/staging/ODM881/disk2/DecisionServerRules'/>
    <repository location='/opt/staging/ODM881/disk2/ProfileTemplateRules'/>
    <repository location='/opt/staging/ODM881/disk3/DC'/>
    <repository location='/opt/staging/ODM881/disk3/ProfileTemplateDC'/>
  </server>
  <profile id='Operational Decision Manager V8.8_ts2' installLocation='/opt/ts2/ODM88'>
    <data key='cic.selector.arch' value='x86_64'/>
    <data key='user.lic.dsr' value='rules'/>
    <data key='user.prod.dsr' value='false'/>
    <data key='user.lic.dc' value='full'/>
    <data key='user.wodm_was_home' value='/opt/ts2/WebSphere/AppServer'/>
  </profile>
  <install>
    <!-- Decision Center 8.8.1.0 -->
    <offering profile='Operational Decision Manager V8.8_ts2' id='com.ibm.websphere.odm.dc.v88' version='8.8.1000.20160527_0751' features='jdk,base,Decision Center'/>
    <!-- Decision Center profile templates for WebSphere Application Server   8.8.1.0 -->
    <offering profile='Operational Decision Manager V8.8_ts2' id='com.ibm.websphere.odm.pt.dc.v88' version='8.8.1000.20160527_0943' features='main.feature'/>
    <!-- Decision Server Rules 8.8.1.0 -->
    <offering profile='Operational Decision Manager V8.8_ts2' id='com.ibm.websphere.odm.ds.rules.v88' version='8.8.1000.20160527_0819' features='com.ibm.wds.jdk.feature,base,com.ibm.wds.rules.res.feature'/>
    <!-- Decision Server Rules profile templates for WebSphere Application Server  8.8.1.0 -->
    <offering profile='Operational Decision Manager V8.8_ts2' id='com.ibm.websphere.odm.pt.rules.v88' version='8.8.1000.20160527_0949' features='main.feature'/>
  </install>
  <preference name='com.ibm.cic.common.core.preferences.eclipseCache' value='${sharedLocation}'/>
  <preference name='offering.service.repositories.areUsed' value='false'/>
</agent-input>